# Copie para .env para sobrescrever os valores (todas as opções são opcionais:
# o docker-compose.yml já traz defaults). O .env NÃO é versionado.

# ---- Postgres ----
POSTGRES_USER=resolve
POSTGRES_PASSWORD=resolve
POSTGRES_DB=resolve_test
POSTGRES_PORT=5432

# ---- Backend (NestJS) ----
BACKEND_PORT=8082
JWT_SECRET=dev-jwt-secret-somente-para-testes
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d
SALT_ROUNDS=10

# ---- Frontend (Next.js) ----
FRONTEND_PORT=3000
FRONTEND_URL=http://localhost:3000
# URL da API chamada pelo navegador (precisa bater com BACKEND_PORT)
NEXT_PUBLIC_API_URL=http://localhost:8082
